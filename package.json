{
  "name": "dsh-worktree-desk",
  "version": "0.5.1",
  "description": "本机 Git 工作树总览：状态、就地差异、本地分支与跨 harness 会话",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomas-zz/dsh-worktree-desk.git"
  },
  "bugs": {
    "url": "https://github.com/Thomas-zz/dsh-worktree-desk/issues"
  },
  "homepage": "https://github.com/Thomas-zz/dsh-worktree-desk",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "worktree"
  ],
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "dev:web": "node scripts/dev-web.mjs",
    "audit": "node scripts/release-audit.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "files": [
    "src",
    "dist",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
